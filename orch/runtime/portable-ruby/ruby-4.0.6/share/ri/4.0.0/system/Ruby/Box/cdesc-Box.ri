@textI"CRuby Box - Ruby's in-process separation of Classes and Modules;To:RDoc::Markup::Paragraph;[I"Ruby Box is designed to provide separated spaces in a Ruby process, to isolate application codes, libraries and monkey patches.;To;	;
i;I"Known issues;To:RDoc::Markup::List:
@type:BULLET:@items[	o:RDoc::Markup::ListItem:@label0;[o;;[I"áExperimental warning is shown when ruby starts with <code>RUBY_BOX=1</code> (specify <code>-W:no-experimental</code> option to hide it);To;;0;[o;;[I"vInstalling native extensions may fail under <code>RUBY_BOX=1</code> because of stack level too deep in extconf.rb;To;;0;[o;;[I"Z<code>require 'active_support/core_ext'</code> may fail under <code>RUBY_BOX=1</code>;To;;0;[o;;[I"UDefined methods in a box may not be referred by built-in methods written in Ruby;To;	;
i;I"
